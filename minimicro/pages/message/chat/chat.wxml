<!-- 聊天详情页 -->
<view class="chat-container">
  <!-- 顶部导航 -->
  <view class="chat-header">
    <view class="header-content">
      <view class="back-btn" bindtap="onBack">返回</view>
      <view class="title">{{chatInfo.name}}</view>
      <view class="more-btn">•••</view>
    </view>
  </view>

  <!-- 聊天内容区域 -->
  <scroll-view 
    class="chat-list" 
    scroll-y="true" 
    scroll-into-view="{{scrollToMessage}}"
    bindscrolltoupper="onLoadMore"
    upper-threshold="50"
    scroll-with-animation="true">
    <!-- 加载更多提示 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    
    <!-- 消息列表 -->
    <view class="messages">
      <view wx:for="{{messages}}" 
        wx:key="index" 
        class="message-item {{item.isSelf ? 'self' : 'other'}}"
        id="msg-{{item.id}}">
        <!-- 时间 -->
        <view class="time" wx:if="{{item.showTime}}">{{item.time}}</view>
        <!-- 消息内容 -->
        <view class="message-content">
          <!-- 对方头像 -->
          <view class="avatar-container" wx:if="{{!item.isSelf}}" bindtap="onAvatarTap" data-user-id="{{chatInfo.id}}">
            <image class="avatar" src="{{chatInfo.avatar}}" mode="aspectFill"/>
          </view>
          <!-- 消息气泡 -->
          <view class="bubble">
            <text class="text">{{item.content}}</text>
          </view>
          <!-- 自己头像 -->
          <view class="avatar-container" wx:if="{{item.isSelf}}" bindtap="onAvatarTap" data-user-id="{{userInfo.id}}">
            <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"/>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入区域 -->
  <view class="input-area">
    <view class="input-box">
      <view class="voice-btn">🎤</view>
      <input type="text" 
        class="text-input" 
        value="{{inputMessage}}"
        bindinput="onInputChange"
        bindconfirm="onSendMessage"
        confirm-type="send"
        placeholder="发送消息"/>
      <view class="emoji-btn">😊</view>
      <view class="more-btn" wx:if="{{!inputMessage}}">+</view>
      <view class="send-btn" wx:else bindtap="onSendMessage">发送</view>
    </view>
  </view>
</view> 