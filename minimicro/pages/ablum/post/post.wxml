<view class="container">
  <!-- Title Input -->
  <!-- <input class="title-input" placeholder="添加标题" bindinput="getTitle"/> -->
  
  <!-- Content Input -->
  <textarea class="content-input" 
            placeholder="添加标题" 
            maxlength="1024"
            value="{{copyData}}"
            bindinput="getTextContent"/>

  <!-- Image Upload Area -->
  <view class="image-upload-area">
    <view class="image-grid">
      <block wx:for="{{uploadedImages}}" wx:key="index">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill"/>
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
      </block>
      <view class="add-image-btn" bindtap="chooseImage" wx:if="{{uploadedImages.length < 3}}">
        <text class="plus-icon">+</text>
      </view>
    </view>
  </view>
  <!-- Bottom Action Bar -->
  <view class="bottom-bar">
    <view class="post-btn" bindtap="post">
      <text>发布</text>
    </view>
  </view>
</view> 
