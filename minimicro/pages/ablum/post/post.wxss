page {
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* .title-input {
  font-size: 32rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
} */

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  line-height: 1.6;
}

.image-upload-area {
  padding: 20rpx 0;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.add-image-btn {
  width: 180rpx;
  height: 180rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.plus-icon {
  font-size: 60rpx;
  color: #999;
  font-weight: 300;
}

.action-buttons {
  display: flex;
  padding: 20rpx 0;
  gap: 20rpx;
  border-bottom: 20rpx solid #f8f8f8;
}

.action-btn {
  background: #f8f8f8;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.action-btn.selected {
  background: #fff2e8;
}

.action-text {
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.action-btn.selected .action-text {
  color: #ff8c1a;
}

.section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  color: #333;
}

.section-arrow {
  color: #999;
  font-size: 28rpx;
}

.advanced-options {
  padding: 30rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #666;
  font-size: 28rpx;
}

.left-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.arrow {
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.post-btn {
  flex: 1;
  margin-left: 20rpx;
  height: 80rpx;
  background: #ff4d4f;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
}

/* Placeholder styles */
.title-input::placeholder,
.content-input::placeholder {
  color: #999;
}

/* Upload component custom styles */
.upload {
  width: 180rpx;
  height: 180rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
} 